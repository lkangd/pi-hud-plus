{
  "name": "pi-hud-plus",
  "version": "0.3.0",
  "description": "A claude-hud-style HUD for pi's footer",
  "type": "module",
  "license": "MIT",
  "author": "lkangd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkangd/pi-hud-plus.git"
  },
  "homepage": "https://github.com/lkangd/pi-hud-plus#readme",
  "bugs": {
    "url": "https://github.com/lkangd/pi-hud-plus/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "hud",
    "statusline"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lkangd/pi-hud-plus/main/docs/screenshot.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'test/*.test.ts'",
    "prepublishOnly": "npm run typecheck && npm test",
    "release": "release-it"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.20.5",
    "release-it": "^21.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
